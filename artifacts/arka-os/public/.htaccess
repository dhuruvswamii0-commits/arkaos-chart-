<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do NOT rewrite direct calls to sync.php
  RewriteRule ^api/sync\.php$ - [L]

  # Direct all other API requests to api/sync.php
  RewriteRule ^api/(.*)$ api/sync.php?endpoint=$1 [QSA,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
